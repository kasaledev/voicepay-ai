# development enables the browser-only demo approval endpoint. Never use it in production.
VOICEPAY_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./voicepay.db
WEBHOOK_SECRET=replace-with-a-long-random-secret
MAX_SINGLE_PAYMENT_TZS=100000
MAX_DAILY_PAYMENT_TZS=500000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Adapter settings: a real implementation belongs behind the payment adapter.
PAYMENT_PROVIDER=mock
LLM_PROVIDER=deterministic
LLM_MODEL=
